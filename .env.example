# Copy to `.env` (gitignored) for local reference only.
# Actual values are passed to the app via --dart-define / --dart-define-from-file,
# never committed and never read from this file at runtime.
#
# AppLovin MAX (locked ad mediation SDK — Phase 4). Empty values leave ads
# disabled rather than erroring; see MaxAdConfig.fromDartDefines.
APPLOVIN_SDK_KEY=
AD_UNIT_REWARDED_HINT=
AD_UNIT_REWARDED_EXTRA_HEART=
AD_UNIT_REWARDED_ARCHIVE_UNLOCK=
AD_UNIT_INTERSTITIAL=
AD_UNIT_BANNER=

# The Google Mobile Ads SDK (used here only for its bundled UMP consent
# flow, not as an ad network) still requires an AdMob App ID declared
# natively — see android/app/src/main/AndroidManifest.xml and
# ios/Runner/Info.plist.
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=

# Firebase (Phase 3 notifications used local notifications only; this is
# for Firebase Analytics, Phase 4). Populate from a real Firebase project
# — see the Phase 4 compliance notes in CLAUDE.md.
FIREBASE_PROJECT_ID=
